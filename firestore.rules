rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 1. GENERAL HELPERS
    // ========================================================================

    // --- Authentication & Identity ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // --- Data Retrieval Shorthands ---
    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    // --- Validation Helpers ---
    
    // Check if a field was changed in this request
    function isFieldChanged(fieldName) {
       return fieldName in incomingData() && 
              (! (fieldName in existingData()) || incomingData()[fieldName] != existingData()[fieldName]);
    }

    // Ensure a field is NOT changed (Immutable)
    // Only checks if the field is present in the incoming update and differs from existing
    function isImmutable(fieldName) {
      return !isFieldChanged(fieldName);
    }
    
    // Check optional field type (allow null or missing, if present must match type)
    // Firestore rules short-circuit, so check uniqueness/existence first if needed.
    // However, simple type checks:
    function isString(dataFrom, field) {
      return field in dataFrom && dataFrom[field] is string;
    }
    
    function isNumber(dataFrom, field) {
      return field in dataFrom && (dataFrom[field] is int || dataFrom[field] is float);
    }

    function isBoolean(dataFrom, field) {
      return field in dataFrom && dataFrom[field] is bool;
    }

    // String Validation
    function isValidString(dataFrom, field, minLen, maxLen) {
      return isString(dataFrom, field) && 
             dataFrom[field].size() >= minLen && 
             dataFrom[field].size() <= maxLen;
    }

    function isOptionalString(dataFrom, field, maxLen) {
      // If field is missing, it's valid. If it exists, must be string <= maxLen
      return !(field in dataFrom) || (dataFrom[field] is string && dataFrom[field].size() <= maxLen);
    }

    // Number Validation
    function isValidNumber(dataFrom, field, minVal, maxVal) {
      return isNumber(dataFrom, field) && 
             dataFrom[field] >= minVal && 
             dataFrom[field] <= maxVal;
    }

    // Timestamp Validation
    function isTimestamp(dataFrom, field) {
      return field in dataFrom && dataFrom[field] is timestamp;
    }

    // Common Schema Checks
    function hasRequiredFields(requiredFields) {
      return incomingData().keys().hasAll(requiredFields);
    }

    // ========================================================================
    // 2. COLLECTION RULES
    // ========================================================================

    // --- USERS ---
    match /users/{userId} {
      // Allow read public, but consider restricting email/phone if they exist in public doctor
      allow read: if true;

      // Create: Users created via Auth, but sometimes doc is created manually
      allow create: if isOwner(userId)
                    && isValidString(incomingData(), 'email', 3, 100)
                    // Initial role setup must be user, cannot set admin
                    && incomingData().get('isAdmin', false) == false
                    && incomingData().get('isVerified', false) == false;

      // Update: Owner can edit profile, but CANNOT elevate privileges
      allow update: if isOwner(userId)
                    // PRIVILEGE ESCALATION PREVENTION
                    && isImmutable('isAdmin')
                    && isImmutable('isVerified')
                    && isImmutable('role')
                    // Data Integrity
                    && isOptionalString(incomingData(), 'bio', 500)
                    && isOptionalString(incomingData(), 'displayName', 100)
                    && isOptionalString(incomingData(), 'location', 100);

      // Private Data Subcollection
      match /private_data/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- TRIPS ---
    match /trips/{tripId} {
      allow read: if true;

      // Create
      allow create: if isAuthenticated()
                    && incomingData().organizerId == request.auth.uid
                    && hasRequiredFields(['title', 'organizerId', 'createdAt'])
                    && isValidString(incomingData(), 'title', 3, 150)
                    // Description optional but capped
                    && isOptionalString(incomingData(), 'description', 2000)
                    && isTimestamp(incomingData(), 'createdAt');

      // Update
      allow update: if isAuthenticated() 
                    && existingData().organizerId == request.auth.uid // Only owner
                    && isImmutable('organizerId') // Cannot change ownership
                    && isImmutable('createdAt')
                    && isOptionalString(incomingData(), 'title', 150)
                    && isOptionalString(incomingData(), 'description', 2000);
      
      // Delete
      allow delete: if isAuthenticated() && (existingData().organizerId == request.auth.uid || isAdmin());
    }

    // --- FORUM ---
    match /forum_posts/{postId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && incomingData().authorId == request.auth.uid
                    && hasRequiredFields(['title', 'content', 'authorId', 'createdAt'])
                    && isValidString(incomingData(), 'title', 3, 150)
                    && isValidString(incomingData(), 'content', 10, 5000);

      allow update: if isAuthenticated() 
                    && existingData().authorId == request.auth.uid
                    && isImmutable('authorId')
                    && isImmutable('createdAt')
                    && isOptionalString(incomingData(), 'title', 150)
                    && isOptionalString(incomingData(), 'content', 5000);

      allow delete: if isAuthenticated() && (existingData().authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
                      && incomingData().userId == request.auth.uid
                      && hasRequiredFields(['content', 'userId'])
                      && isValidString(incomingData(), 'content', 1, 1000);
        
        allow update: if isAuthenticated()
                      && existingData().userId == request.auth.uid
                      && isImmutable('userId')
                      && isValidString(incomingData(), 'content', 1, 1000);

        allow delete: if isAuthenticated() && (existingData().userId == request.auth.uid || isAdmin());
      }
    }

    // --- SPOTS ---
    match /spots/{spotId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    // Allow anyone to create, must mark themselves as contributor
                    && incomingData().contributorId == request.auth.uid
                    && hasRequiredFields(['name', 'location', 'contributorId'])
                    && isValidString(incomingData(), 'name', 3, 100);

      allow update: if isAuthenticated() && (existingData().contributorId == request.auth.uid || isAdmin())
                    && isImmutable('contributorId')
                    && isImmutable('createdAt')
                    && isOptionalString(incomingData(), 'name', 100);

      allow delete: if isAuthenticated() && (existingData().contributorId == request.auth.uid || isAdmin());
    }

    // --- SERVICES ---
    match /services/{serviceId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && incomingData().providerId == request.auth.uid
                    && hasRequiredFields(['title', 'providerId', 'price'])
                    && isValidString(incomingData(), 'title', 3, 150)
                    && isNumber(incomingData(), 'price');

      allow update: if isAuthenticated() 
                    && existingData().providerId == request.auth.uid
                    && isImmutable('providerId')
                    && isImmutable('createdAt')
                    && isOptionalString(incomingData(), 'title', 150);

      allow delete: if isAuthenticated() && (existingData().providerId == request.auth.uid || isAdmin());
    }

    // --- TRIP REQUESTS ---
    match /trip_requests/{reqId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && incomingData().requesterId == request.auth.uid
                    && hasRequiredFields(['destination', 'requesterId'])
                    && isValidString(incomingData(), 'destination', 2, 100);

      allow update: if isAuthenticated() 
                    && existingData().requesterId == request.auth.uid
                    && isImmutable('requesterId')
                    && isImmutable('createdAt');

      allow delete: if isAuthenticated() && (existingData().requesterId == request.auth.uid || isAdmin());
    }

    // --- BUDDIES ---
    match /buddies/{buddyId} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && incomingData().organizerId == request.auth.uid
                    && hasRequiredFields(['destination', 'organizerId'])
                    && isValidString(incomingData(), 'destination', 2, 100);

      allow update: if isAuthenticated() 
                    && existingData().organizerId == request.auth.uid
                    && isImmutable('organizerId');

      allow delete: if isAuthenticated() && (existingData().organizerId == request.auth.uid || isAdmin());
    }

    // --- REPORTS ---
    match /reports/{reportId} {
      // Create: Users can report content
      allow create: if isAuthenticated()
                    && hasRequiredFields(['reason', 'targetId', 'reportedBy'])
                    && incomingData().reportedBy == request.auth.uid
                    && isValidString(incomingData(), 'reason', 3, 500);

      // Read/Update/Delete: Admin Only
      allow read, update, delete: if isAdmin();
    }

    // --- SITE SETTINGS ---
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      // Private to user
      allow read: if isAuthenticated() && existingData().userId == request.auth.uid;
      
      // Usually created by Cloud Functions (backend), so 'create' might not be needed from client.
      // If client creates notifications (e.g. "Someone liked your post"), verify sender.
      // Assuming strictly backend or carefully monitored:
      allow create: if isAuthenticated() 
                    && incomingData().userId != null; // Ideally check ownership of target or logic

      allow update: if isAuthenticated()
                    && existingData().userId == request.auth.uid
                    // Can only update 'read' status usually
                    && isImmutable('userId')
                    && isImmutable('type');
                    
      allow delete: if isAuthenticated() && existingData().userId == request.auth.uid;
    }
  }
}