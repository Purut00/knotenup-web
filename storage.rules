rules_version = '2';

// Perhatikan baris ini: Mesti 'firebase.storage', BUKAN 'cloud.firestore'
service firebase.storage {
  match /b/{bucket}/o {
    // 1. PUBLIC READ (Images are public)
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. USER UPLOADS (Strict enforcement)
    // Path: /uploads/{userId}/{...}
    match /uploads/{userId}/{allPaths=**} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && (
                     request.resource.contentType.matches('image/.*') || 
                     request.resource.contentType.matches('application/gpx+xml')
                   );
    }

    // 3. ADMIN BANNERS (Admin only)
    match /banners/{allPaths=**} {
      allow write: if request.auth != null 
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}