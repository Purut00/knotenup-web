rules_version = '2';

// Perhatikan baris ini: Mesti 'firebase.storage', BUKAN 'cloud.firestore'
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // 1. Benarkan sesiapa sahaja MELIHAT gambar (Read)
      allow read: if true;

      // 2. Benarkan upload/delete HANYA jika user sudah login (Write)
      allow write: if request.auth != null;
    }
  }
}